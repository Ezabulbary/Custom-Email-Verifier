# --- Backend environment variables ---
# Copy to `.env` and fill in real values:  cp .env.example .env

# Run mode. Keep 'development' for local runs. Set to 'production' ONLY on your
# live server — in production JWT_SECRET becomes mandatory (the server refuses
# to start without it) so tokens can't be forged with a guessable default.
NODE_ENV=development

# Port the API listens on (nginx proxies to this).
PORT=3001

# Required when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# NOTE: `node server.js` auto-loads this .env file (Node 20.12+). No --env-file
# flag is needed.

# Comma-separated list of allowed browser origins for CORS. Leave EMPTY for
# local development (allows all). On your live server set it to your frontend
# URL, e.g. CORS_ORIGINS=https://verifier.yourdomain.com
CORS_ORIGINS=

# Frontend URL used to build the password-reset link in the email.
# Local dev default is http://localhost:5173; set to your live frontend origin.
FRONTEND_URL=http://localhost:5173

# --- Password-reset email ---
# Reset emails are sent via SMTP (nodemailer, already built in). Set these and
# real emails go out automatically; leave them blank and the reset link is just
# printed to the backend console (fine for local testing). See SETUP.md §6.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password>  (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BounceCure <no-reply@yourdomain.com>

# Roles: superadmin > admin > user.
# - The VERY FIRST registered account automatically becomes superadmin.
# - SUPERADMIN_EMAIL: this account is promoted to superadmin on startup.
# - ADMIN_EMAIL: this account is promoted to admin on startup.
# (Both work for already-registered users too.)
# Admin-panel visibility:
#   - Superadmin sees ALL users (users, admins and superadmins).
#   - Admin sees users and admins, but NOT superadmins.
#   - A regular user has no admin panel — they only ever see their own account
#     and their own verification data (Overview, My Account, Tasks & Results).
SUPERADMIN_EMAIL=
ADMIN_EMAIL=

# Set to 1 ONLY if you intentionally verify against a mail server on a private/
# internal IP. Leave unset in normal deployments (SSRF protection stays on).
# ALLOW_PRIVATE_MX=

# --- Email verification tuning (SMTP) ---
# Real mailbox verification needs outbound port 25 open (check /health -> port25).
# For GOOD ACCURACY, set the HELO/MAIL FROM to a REAL domain you control — mail
# servers (Gmail, Outlook…) greylist/block a fake sender and return "unknown".
# Best results: point VERIFY_HELO_DOMAIN at this server's reverse DNS (PTR) and
# add an SPF record for it. See ACCURACY.md.
# VERIFY_HELO_DOMAIN=mail.yourdomain.com
# VERIFY_MAIL_FROM=verify@yourdomain.com
#
# How many emails to verify at once (default 10). Lower it if a provider
# rate-limits you (symptom: many temporary failures / "unknown").
# VERIFY_CONCURRENCY=10
# Per-connection SMTP timeout in ms (default 12000).
# SMTP_TIMEOUT_MS=12000
# Max addresses processed in a single job (default 50000). Guards memory/CPU
# against one huge upload — split larger lists into multiple files.
# MAX_EMAILS_PER_JOB=50000

# --- Firebase (REQUIRED) — Cloud Firestore data store + Google sign-in ---
# This app stores ALL data in Cloud Firestore, so a Firebase service account is
# REQUIRED. The same account also enables "Continue with Google". Without it the
# server refuses to start (see FIRESTORE-SETUP.md).
#
# Simplest: drop the key as ./serviceAccount.json in the project root — it is
# auto-detected, no env var needed.
#
# ...OR paste the service-account JSON (one line, Firebase console →
# Project settings → Service accounts → Generate new private key):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
#
# ...OR point to the downloaded file:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
