# =============================================================================
# Backend environment variables
# Copy to `.env` and fill in real values:  cp .env.example .env
# `node server.js` auto-loads .env (Node 20.12+); no --env-file flag needed.
#
# LEGEND (how the lines below are marked):
#   ### VAR=...   MUST be set for a production deployment
#   ## VAR=...    optional (has a safe default, or enables an extra feature)
#   # text        normal explanation comment
# To activate a variable, remove the leading hashes from its line.
# =============================================================================


# --- Core (MUST) -------------------------------------------------------------

# Run mode. Keep 'development' for local runs. Set to 'production' ONLY on the
# live server; in production JWT_SECRET becomes mandatory (the server refuses
# to start without it) so tokens can't be forged with a guessable default.
### NODE_ENV=production

# Signs login tokens. REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
### JWT_SECRET=

# Where the frontend lives. Used to build password-reset links and Stripe
# success/cancel redirects. Local dev default: http://localhost:5173
### FRONTEND_URL=https://verify.yourdomain.com

# Cloud Firestore is this app's ONLY data store; a Firebase service account is
# REQUIRED or the server refuses to start (see README.md §3a). Satisfy it in
# ANY ONE of these three ways (the file is the simplest):
#   1) drop the key as ./serviceAccount.json in the project root (auto-detected,
#      no env var needed), OR
#   2) paste the JSON one-line (Firebase console -> Project settings ->
#      Service accounts -> Generate new private key):
### FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#   3) or point to the downloaded file:
### GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json


# --- Server (optional) -------------------------------------------------------

# Port the API listens on (nginx proxies to this). Default 3001.
## PORT=3001

# Comma-separated allowed browser origins for CORS. Leave EMPTY when nginx
# proxies everything same-origin (recommended setup); set it only when the
# frontend is served from a DIFFERENT origin than the API.
## CORS_ORIGINS=https://verifier.yourdomain.com

# Reverse-proxy hops to trust for the real client IP (rate limiting, HTTPS
# detection). Default 1 = a single nginx in front. 0 = no proxy (direct).
## TRUST_PROXY=1


# --- Roles (optional) --------------------------------------------------------

# superadmin > admin > user. The VERY FIRST registered account automatically
# becomes superadmin. These promote the given accounts on startup (works for
# already-registered users too). Admin panel: superadmin sees everyone; admin
# sees users+admins but never superadmins; users have no admin panel.
## SUPERADMIN_EMAIL=you@yourcompany.com
## ADMIN_EMAIL=teammate@yourcompany.com


# --- Password-reset email via SMTP (optional) --------------------------------

# Set these and reset emails go out automatically; leave blank and the reset
# link is only printed to the backend console (fine for local testing).
# Gmail needs an App Password: https://myaccount.google.com/apppasswords
## SMTP_HOST=smtp.gmail.com
## SMTP_PORT=587
## SMTP_USER=you@gmail.com
## SMTP_PASS=your16charapppassword
## SMTP_FROM=BounceCure <no-reply@yourdomain.com>


# --- Verification accuracy & tuning (optional, strongly recommended) ---------

# Real mailbox verification needs outbound port 25 open (check /health ->
# "port25"). For GOOD ACCURACY set HELO/MAIL FROM to a REAL domain you control;
# mail servers greylist/block a fake sender and return "unknown". Best results:
# VERIFY_HELO_DOMAIN = this server's reverse DNS (PTR), plus an SPF record.
# See README.md §4. (A bare IP works too and is auto-bracketed, but a real
# domain performs far better.)
## VERIFY_HELO_DOMAIN=mail.yourdomain.com
## VERIFY_MAIL_FROM=verify@yourdomain.com

# Parallel SMTP checks per job (default 10). Lower it if providers rate-limit
# you (symptom: many temporary failures / "unknown").
## VERIFY_CONCURRENCY=10

# Parallel checks for the free Bounce Rate analyzer (DNS only; default 50).
## QUICK_CONCURRENCY=50

# Per-connection SMTP timeout in ms (default 12000).
## SMTP_TIMEOUT_MS=12000

# Retries on a temporary/greylisting (4xx) SMTP reply before giving up as
# "unknown" (default 2). Greylisting is common; retries recover real mailboxes.
## SMTP_RETRIES=2

# MX hosts to try per address, highest priority first (default 3). The primary
# MX often greylists/drops while a backup answers; trying more turns "unknown"
# into real verdicts, at the cost of speed on fully-dead domains.
## MAX_MX_HOSTS=3

# Random probes used to detect a catch-all domain (default 2).
## CATCH_ALL_PROBES=2

# Extra spam-trap domains (comma-separated) added to the built-in detection.
## SPAMTRAP_DOMAINS=trap1.example.com,trap2.example.com

# Max addresses in a single job (default 50000). Guards memory/CPU against one
# huge upload; split larger lists into multiple files.
## MAX_EMAILS_PER_JOB=50000

# Set to 1 ONLY to verify against a mail server on a private/internal IP.
# Leave unset in normal deployments (SSRF protection stays on).
## ALLOW_PRIVATE_MX=1


# --- Billing / payments (optional; for the "Buy Credits" page) ---------------

# Stripe (card payments). Without STRIPE_SECRET_KEY the card option tells the
# buyer to use Wise or bank transfer. Create a webhook endpoint in the Stripe
# dashboard pointing at /billing/stripe/webhook for checkout.session.completed;
# only REAL (live-mode) paid checkouts add credits, test mode never does.
## STRIPE_SECRET_KEY=sk_live_xxx
## STRIPE_WEBHOOK_SECRET=whsec_xxx

# Wise (shown on the Buy Credits page when set):
## WISE_PAYMENT_URL=https://wise.com/pay/me/yourname
## WISE_EMAIL=billing@yourdomain.com

# International bank transfer (any subset shown when set):
## BANK_HOLDER=Your Company Ltd
## BANK_NAME=Example Bank
## BANK_ACCOUNT=1234567890
## BANK_IBAN=GB00EXAM12345678901234
## BANK_SWIFT=EXAMGB2L
## BANK_NOTES=Include your payment reference in the transfer note

# Where manual (Wise/bank) payment notifications are emailed:
## BILLING_NOTIFY_EMAIL=billing@yourdomain.com


# --- Admin safety (optional) -------------------------------------------------

# Largest single credit adjustment an admin can apply (default 1000000), so a
# typo can't mint millions of credits.
## MAX_CREDIT_DELTA=1000000
